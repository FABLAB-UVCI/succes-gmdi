# ── succes-gmdi / docker-compose ─────────────────────────────
# Variables d'environnement pour l'orchestration Docker (pattern YATANAN).
# Copier en `.env` à la racine de succes-gmdi (ou fournir via l'hôte).
# ⚠ Le `.env` réel est dans .gitignore — ne jamais committer de secrets.

# Domaine public unique — /api → backend Laravel, / → frontend Angular
DOMAIN=e-mairie.voisilab.com
APP_URL=https://e-mairie.voisilab.com

# ── Base de données Postgres EXTERNE (Neon/Voisilab) ──
# MODE RECOMMANDÉ — variables décomposées. DB_HOST est OBLIGATOIRE
# (le compose échoue si absent, pas de repli localhost).
# Décompose ta connection string Neon : postgresql://USER:PASS@HOST/DB?sslmode=require
DB_HOST=ep-xxxx-xxxx.us-east-2.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=ton_user_neon
DB_PASSWORD=ton_password_neon
# Neon/Postgres hébergé exige SSL
DB_SSLMODE=require

# Mode ALTERNATIF — connection string COMPLÈTE (si renseignée, elle PRIME
# sur les variables ci-dessus). Décommenter et remplir :
# DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Jeton requis par la route GET /api/system/deploy-setup
# (migration + seed idempotents, à appeler une fois après déploiement)
DEPLOY_TOKEN=change_me_deploy_token